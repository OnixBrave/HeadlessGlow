    "The Touch Bar follows the keyboard level, but stays on when the keyboard is off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Touch Bar folgt der Tastaturhelligkeit, bleibt aber an, wenn die Tastaturbeleuchtung aus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Touch Bar sigue el nivel del teclado, pero se mantiene encendida cuando el teclado está apagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Touch Bar suit le niveau du clavier, mais reste allumée quand le clavier est éteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Touch Bar segue il livello della tastiera, ma resta accesa quando la tastiera è spenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Bar はキーボードの明るさに連動しますが、キーボードが消灯しても点灯したままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Touch Bar acompanha o nível do teclado, mas continua acesa quando o teclado está apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Bar следует уровню клавиатуры, но остаётся включённой, когда подсветка клавиатуры выключена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控栏跟随键盘亮度，但键盘背光关闭时仍保持点亮。"
          }
        }
      }
    },
    "The backlight comes back on as soon as you use the keyboard, trackpad or mouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beleuchtung geht wieder an, sobald du Tastatur, Trackpad oder Maus benutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La retroiluminación vuelve a encenderse en cuanto usas el teclado, el trackpad o el ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rétroéclairage se rallume dès que vous utilisez le clavier, le trackpad ou la souris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La retroilluminazione si riaccende appena usi la tastiera, il trackpad o il mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード、トラックパッド、マウスを使うとすぐにバックライトが再点灯します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A retroiluminação volta a acender assim que você usa o teclado, o trackpad ou o mouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка снова включается, как только вы используете клавиатуру, трекпад или мышь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用键盘、触控板或鼠标时，背光会立即重新点亮。"
          }
        }
      }
    },
