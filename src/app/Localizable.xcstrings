    "HeadlessGlow %@ · drives the T2 controller directly, without modifying the system.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · steuert den T2-Controller direkt, ohne das System zu verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · controla directamente el controlador del T2, sin modificar el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · pilote directement le contrôleur du T2, sans modifier le système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · controlla direttamente il controller del T2, senza modificare il sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · システムを変更せずに T2 コントローラを直接制御します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · controla diretamente o controlador do T2, sem modificar o sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · управляет контроллером T2 напрямую, не изменяя систему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HeadlessGlow %@ · 直接控制 T2 控制器，不修改系统。"
          }
        }
      }
    },
