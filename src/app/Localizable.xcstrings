    "Hold ⌥⇧ while tapping a brightness control for finer steps, or ⌥ to open these settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌥⇧ beim Tippen auf eine Helligkeitstaste gedrückt, um feinere Stufen zu erhalten, oder ⌥, um diese Einstellungen zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsadas ⌥⇧ al tocar un control de brillo para pasos más finos, o ⌥ para abrir estos ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥⇧ en touchant une commande de luminosité pour un réglage plus fin, ou ⌥ pour ouvrir ces réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuti ⌥⇧ mentre tocchi un controllo della luminosità per passi più fini, oppure ⌥ per aprire queste impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧ を押しながら輝度コントロールをタップすると細かく調整でき、⌥ を押しながらタップするとこの設定が開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌥⇧ pressionadas ao tocar em um controle de brilho para ajustes mais finos, ou ⌥ para abrir estes ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌥⇧, нажимая кнопку яркости, чтобы менять уровень мельче, или ⌥, чтобы открыть эти настройки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点亮度控制时按住 ⌥⇧ 可微调，按住 ⌥ 可打开此设置。"
          }
        }
      }
    },
    "If the icon is hidden, open HeadlessGlow from Spotlight or Launchpad to get back to these settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Symbol ausgeblendet ist, öffne HeadlessGlow über Spotlight oder das Launchpad, um zu diesen Einstellungen zurückzukehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el icono está oculto, abre HeadlessGlow desde Spotlight o Launchpad para volver a estos ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’icône est masquée, ouvrez HeadlessGlow depuis Spotlight ou le Launchpad pour retrouver ces réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'icona è nascosta, apri HeadlessGlow da Spotlight o Launchpad per tornare a queste impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンが非表示の場合は、Spotlight または Launchpad から HeadlessGlow を開くとこの設定に戻れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o ícone estiver oculto, abra o HeadlessGlow pelo Spotlight ou pelo Launchpad para voltar a estes ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значок скрыт, откройте HeadlessGlow через Spotlight или Launchpad, чтобы вернуться к этим настройкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果图标已隐藏，可从聚焦或启动台打开 HeadlessGlow 以返回此设置。"
          }
        }
      }
    },
