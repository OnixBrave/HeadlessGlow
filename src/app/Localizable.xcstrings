          }
        }
      }
    },
    "Without an ambient light sensor, the Touch Bar can't get brighter than its current level: this setting can only dim it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Umgebungslichtsensor kann die Touch Bar nicht heller werden als jetzt: Diese Einstellung kann sie nur abdunkeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sensor de luz ambiental, la Touch Bar no puede ser más brillante que su nivel actual: este ajuste solo permite atenuarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans capteur de lumière, la Touch Bar ne peut pas dépasser sa luminosité actuelle : ce réglage permet seulement de l’atténuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza sensore di luce ambientale, la Touch Bar non può diventare più luminosa del livello attuale: questa impostazione può solo attenuarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境光センサーがないため、Touch Bar を現在より明るくすることはできません。この設定では暗くすることだけができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem o sensor de luz ambiente, a Touch Bar não pode ficar mais clara que o nível atual: este ajuste só permite escurecê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без датчика освещённости Touch Bar не может стать ярче текущего уровня: эта настройка позволяет только затемнять её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有环境光传感器时，触控栏无法比当前更亮：此设置只能将其调暗。"
          }
        }
      }
    },
